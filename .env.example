# ==============================================================================
# SMART ONE-STOP SERVICE CENTER - ENVIRONMENT CONFIGURATION TEMPLATE
# Addis Ababa City Administration (የአዲስ አበባ ከተማ አስተዳደር)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. APPLICATION & SERVER SETTINGS
# ------------------------------------------------------------------------------
PORT=8080
APP_ENV=development # options: development, staging, production
CORS_ALLOW_ORIGINS=*
JWT_SECRET=smart-onestop-municipal-hearing-secure-token-secret-2026

# ------------------------------------------------------------------------------
# 2. DATABASE CONFIGURATION
# ------------------------------------------------------------------------------
# DB_DRIVER options: 'postgres' (production/docker) or 'sqlite' (local testing)
DB_DRIVER=postgres
DATABASE_URL=postgres://postgres:postgres123@localhost:5432/smart_onestop?sslmode=disable
DB_PASSWORD=postgres123

# For SQLite local file storage:
# DB_DRIVER=sqlite
# DATABASE_URL=smart_onestop.db

# ------------------------------------------------------------------------------
# 3. REDIS CACHE & DISTRIBUTED LOCKS
# ------------------------------------------------------------------------------
REDIS_URL=redis://localhost:6379/0

# ------------------------------------------------------------------------------
# 4. BACKGROUND SLA SWEEP WORKER
# ------------------------------------------------------------------------------
# Interval in seconds between automated SLA breach sweeps across all active tiers
WORKER_INTERVAL_SEC=60

# ------------------------------------------------------------------------------
# 5. ETHIOPIAN WORKING-DAY ENGINE CONFIGURATION
# ------------------------------------------------------------------------------
# Official timezone for municipal working days and digital hearing calendars
CALENDAR_TIMEZONE=Africa/Addis_Ababa

# Standard working schedule: Monday through Friday (08:30 - 17:00)
CALENDAR_WORKDAYS=Monday,Tuesday,Wednesday,Thursday,Friday
CALENDAR_WORKDAY_START=08:30
CALENDAR_WORKDAY_END=17:00

# Optional Saturday half-day schedule (08:30 - 12:30)
CALENDAR_SATURDAY_HALF_DAY=false
CALENDAR_SATURDAY_END=12:30

# ------------------------------------------------------------------------------
# 6. S3 / MINIO EVIDENCE VAULT
# ------------------------------------------------------------------------------
MINIO_ENDPOINT=localhost:9000
MINIO_ROOT_USER=admin
MINIO_ROOT_PASSWORD=minioadmin123
MINIO_BUCKET=smart-onestop-evidence
MINIO_USE_SSL=false
