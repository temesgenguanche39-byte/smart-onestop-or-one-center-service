{
  "version": 2,
  "framework": null,
  "outputDirectory": "web/static",
  "cleanUrls": true,
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/static/(.*)",
      "destination": "/$1"
    },
    {
      "source": "/healthz",
      "destination": "https://better-trees-wash.loca.lt/healthz"
    },
    {
      "source": "/api/v1/(.*)",
      "destination": "https://better-trees-wash.loca.lt/api/v1/$1"
    }
  ]
}
